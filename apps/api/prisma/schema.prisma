generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PARENT
  CHILD
}

enum PurseType {
  EXPENSES
  SAVINGS
  DONATION
}

enum LedgerKind {
  INCOME_ALLOCATION
  EXPENSE
  CASH_REQUEST_PAID
  INTEREST_CREDIT
  SAVINGS_GOAL_REDEEMED
  DONATION_COMPLETED
  REVERSAL
  TASK_REWARD
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

model Family {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  timezone    String   @default("Asia/Jerusalem")
  createdAt   DateTime @default(now())
  users       User[]
  children    Child[]
  allocation  AllocationPolicy?
  interest    InterestPolicy?
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  familyId     String    @db.Uuid
  email        String    @unique
  name         String
  passwordHash String
  role         UserRole  @default(PARENT)
  createdAt    DateTime  @default(now())
  family       Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  sessions     Session[]
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model Child {
  id        String   @id @default(uuid()) @db.Uuid
  familyId  String   @db.Uuid
  name      String
  birthYear Int?
  avatar    String   @default("🧒")
  archivedAt DateTime?
  createdAt DateTime @default(now())
  family    Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  purses    Purse[]
  allocation ChildAllocationPolicy?
  accessLink ChildAccessLink?
  tasks     PurseTask[]
  goals     SavingsGoal[]
  requests  CashRequest[]
  @@index([familyId, archivedAt])
}

model Purse {
  id        String     @id @default(uuid()) @db.Uuid
  childId   String     @db.Uuid
  type      PurseType
  createdAt DateTime   @default(now())
  child     Child      @relation(fields: [childId], references: [id], onDelete: Cascade)
  entries   LedgerEntry[]
  tasks     PurseTask[]
  @@unique([childId, type])
}

model LedgerEntry {
  id             String     @id @default(uuid()) @db.Uuid
  familyId       String     @db.Uuid
  purseId        String     @db.Uuid
  kind           LedgerKind
  amountAgorot   Int
  idempotencyKey String
  note           String?
  createdAt      DateTime   @default(now())
  purse          Purse      @relation(fields: [purseId], references: [id], onDelete: Restrict)
  @@unique([familyId, idempotencyKey])
  @@index([purseId, createdAt])
  @@index([familyId, createdAt])
}

model AllocationPolicy {
  id           String   @id @default(uuid()) @db.Uuid
  familyId     String   @unique @db.Uuid
  expensesBps  Int
  savingsBps   Int
  donationBps  Int
  effectiveAt  DateTime @default(now())
  family       Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
}

model InterestPolicy {
  id          String   @id @default(uuid()) @db.Uuid
  familyId    String   @unique @db.Uuid
  annualBps   Int      @default(0)
  effectiveAt DateTime @default(now())
  family      Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
}

model SavingsGoal {
  id           String    @id @default(uuid()) @db.Uuid
  childId      String    @db.Uuid
  title        String
  targetAgorot Int
  active       Boolean   @default(true)
  achievedAt   DateTime?
  redeemedAt   DateTime?
  createdAt    DateTime  @default(now())
  child        Child     @relation(fields: [childId], references: [id], onDelete: Cascade)
  @@index([childId, active])
}

model CashRequest {
  id           String        @id @default(uuid()) @db.Uuid
  childId      String        @db.Uuid
  amountAgorot Int
  reason       String?
  status       RequestStatus @default(PENDING)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  child        Child         @relation(fields: [childId], references: [id], onDelete: Cascade)
  @@index([childId, status, createdAt])
}

model ChildAllocationPolicy {
  id          String   @id @default(uuid()) @db.Uuid
  childId     String   @unique @db.Uuid
  expensesBps Int
  savingsBps  Int
  donationBps Int
  effectiveAt DateTime @default(now())
  child       Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
}

model ChildAccessLink {
  id        String    @id @default(uuid()) @db.Uuid
  childId   String    @unique @db.Uuid
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  child     Child     @relation(fields: [childId], references: [id], onDelete: Cascade)
  @@index([tokenHash, revokedAt])
}


model PurseTask {
  id                 String         @id @default(uuid()) @db.Uuid
  childId            String         @db.Uuid
  purseId            String?        @db.Uuid
  title              String
  frequency          TaskFrequency
  amountAgorot       Int
  weeklyRequiredCount Int           @default(3)
  active             Boolean        @default(true)
  createdAt          DateTime       @default(now())
  child              Child          @relation(fields: [childId], references: [id], onDelete: Cascade)
  purse              Purse?         @relation(fields: [purseId], references: [id], onDelete: Cascade)
  approvals          TaskApproval[]
  rewards            TaskReward[]
  @@index([childId, active])
  @@index([purseId, active])
}

enum TaskFrequency {
  DAILY
  WEEKLY
}

model TaskApproval {
  id          String    @id @default(uuid()) @db.Uuid
  taskId      String    @db.Uuid
  completedOn DateTime  @db.Date
  approvedById String   @db.Uuid
  createdAt   DateTime  @default(now())
  task        PurseTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  @@unique([taskId, completedOn])
  @@index([taskId, completedOn])
}

model TaskReward {
  id          String    @id @default(uuid()) @db.Uuid
  taskId      String    @db.Uuid
  weekStart   DateTime  @db.Date
  createdAt   DateTime  @default(now())
  task        PurseTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  @@unique([taskId, weekStart])
}
